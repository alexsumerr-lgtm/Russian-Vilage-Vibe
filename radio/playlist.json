---
---
{%- assign exts = ".mp3,.m4a,.aac,.ogg,.oga,.opus,.wav,.flac" | split: "," -%}
{%- assign songs = "" | split: "" -%}
{%- for f in site.static_files -%}
  {%- assign ext = f.extname | downcase -%}
  {%- if f.path contains "/radio/" and exts contains ext -%}{%- assign songs = songs | push: f.name -%}{%- endif -%}
{%- endfor -%}
{"songs": {{ songs | jsonify }}}
